DATABASE_URL=postgres://openperiod:openperiod@localhost:5432/openperiod
OPENPERIOD_SEMESTER_START=2026-09-07

# 管理页 /admin 的访问密钥（只有持有者能看全站账号与群组，只读）。不配置则管理接口一律拒绝。
ADMIN_KEY=

# 注册、首次设密码、找回密码验证码的 HMAC 密钥：至少 32 字符，各实例一致；用 openssl rand -hex 32 生成。
# 修改密钥会使尚未使用的验证码失效，不影响现有密码和有效会话。
AUTH_SECRET=
# 生产环境必须填写公开 HTTPS origin，如 https://example.com（不带路径或末尾斜杠）。
# 本地开发可留空。
AUTH_ORIGIN=
# 生产只允许位于可信反向代理后的实例启用；应用端口必须仅绑定回环或容器私网。
# 代理必须覆盖（不能追加或透传客户端的）X-Forwarded-Proto: https。
TRUST_PROXY_HEADERS=

# 注册、老账号首次设密码、找回密码需要邮件；日常密码登录不需要。
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
DIRECTMAIL_ACCOUNT=
DIRECTMAIL_FROM_ALIAS=课隙
# 可选，默认 cn-hangzhou。
DIRECTMAIL_REGION=cn-hangzhou

# 可选：智谱开放平台 API Key。留空时 AI 截图／文字导入不可用，Excel 与手动编辑仍可用。
ZHIPU_API_KEY=

# ICP 备案号（如「京ICP备2026xxxxxx号」）：设置后展示在页面底部中间并链接工信部备案系统。
# 构建时注入，修改后需要重新构建/部署才会生效。
NEXT_PUBLIC_ICP_BEIAN=
